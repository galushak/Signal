# Copy to .env and replace with a long, unique secret.
POSTGRES_PASSWORD=change-me-before-production
JWT_SECRET=replace-with-a-long-random-secret
ENVIRONMENT=production
WEB_PORT=3000
API_PORT=8000

# Use the internal VM hostname when the browser is served through Cloudflare.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Required only when starting the optional Cloudflare Tunnel profile.
CLOUDFLARE_TUNNEL_TOKEN=
