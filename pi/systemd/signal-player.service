[Unit]
Description=Signal Player Agent
Documentation=https://github.com/galushak/Signal
After=local-fs.target network.target
Wants=network.target
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=signal-player
Group=signal-player
WorkingDirectory=/opt/signal-player
Environment=SIGNAL_PLATFORM=raspberry-pi
Environment=SIGNAL_STATE_DIR=/var/lib/signal-player
Environment=SIGNAL_CONFIG_PATH=/etc/signal-player/config.toml
ExecStart=/opt/signal-player/venv/bin/python -m uvicorn app.main:app --host 127.0.0.1 --port 8090
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/var/lib/signal-player /etc/signal-player

[Install]
WantedBy=multi-user.target
