#!/bin/sh
# Started by the active graphical session. The loop is the renderer watchdog:
# Chromium is restarted after a crash without restarting the agent.
set -eu

# Raspberry Pi OS normally owns the graphical session with a regular local
# account. Keep that account's Wayland/X session and writable home directory.
# The dedicated service account still uses its private state directory when it
# is the account that starts the kiosk.
if [ "$(id -un)" = "signal-player" ]; then
  export HOME=/var/lib/signal-player
fi

export XDG_CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}"
export XDG_CACHE_HOME="${XDG_CACHE_HOME:-$HOME/.cache}"
mkdir -p "$XDG_CONFIG_HOME" "$XDG_CACHE_HOME"

while true; do
  chromium \
    --kiosk \
    --noerrdialogs \
    --disable-infobars \
    --disable-session-crashed-bubble \
    --disable-features=Translate \
    --autoplay-policy=no-user-gesture-required \
    --mute-audio \
    --no-first-run \
    --no-default-browser-check \
    --disable-pinch \
    --overscroll-history-navigation=0 \
    http://127.0.0.1:8090/player || true
  sleep 3
done
