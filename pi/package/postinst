#!/bin/sh
set -e

case "$1" in
  configure)
    if ! getent passwd signal-player >/dev/null; then
      adduser --system --group --home /var/lib/signal-player --shell /usr/sbin/nologin signal-player
    fi
    install -d -o signal-player -g signal-player -m 0700 \
      /var/lib/signal-player \
      /var/lib/signal-player/identity \
      /var/lib/signal-player/manifest \
      /var/lib/signal-player/cache \
      /var/lib/signal-player/runtime \
      /var/lib/signal-player/.config \
      /var/lib/signal-player/.cache
    install -d -o root -g signal-player -m 0770 /etc/signal-player
    if [ ! -f /etc/signal-player/config.toml ]; then
      install -o root -g signal-player -m 0660 /usr/share/signal-player/config.toml /etc/signal-player/config.toml
    else
      chown root:signal-player /etc/signal-player/config.toml
      chmod 0660 /etc/signal-player/config.toml
    fi
    if command -v systemctl >/dev/null 2>&1; then
      systemctl daemon-reload || true
      systemctl enable signal-player.service || true
    fi
    ;;
esac

exit 0
